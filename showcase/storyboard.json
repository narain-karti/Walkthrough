{
  "title": "Nexus Pulse Cloud Observability Walkthrough",
  "mode": "walkthrough",
  "voiceGender": "Female",
  "voice": "en-US-AvaMultilingualNeural",
  "baseUrl": "../demo/index.html",
  "outputDir": "./walkthrough-output",
  "steps": [
    {
      "desc": "Scene 1: Initial overview",
      "holdMs": 6144
    },
    {
      "desc": "Switch to 30-Day metrics window",
      "selector": "button#tab-30d",
      "action": "click",
      "zoomOnClick": true,
      "waitFor": { "selector": "button#tab-30d.active" },
      "holdMs": 5286
    },
    {
      "desc": "Filter microservices by typing polars",
      "selector": "input#service-search",
      "action": "type",
      "text": "polars",
      "waitFor": { "selector": "input#service-search", "value": "polars" },
      "typeDelay": 85,
      "zoomOnClick": true,
      "holdMs": 2688
    },
    {
      "desc": "Trigger canary deploy and observe toast confirmation",
      "selector": "button#btn-deploy",
      "action": "click",
      "zoomOnClick": true,
      "waitFor": { "selector": "#toast.show" },
      "holdMs": 4374
    }
  ]
}
