{
  "name": "walkthrough",
  "version": "2.0.0",
  "description": "Autonomous product demo video generator — physics cursor, cinematic camera, neural voiceover",
  "main": "engine/record.js",
  "bin": {
    "walkthrough": "bin/walkthrough.js"
  },
  "scripts": {
    "demo": "node bin/walkthrough.js demo",
    "record": "node engine/record.js",
    "audio": "python engine/audio_synthesizer.py",
    "sfx": "python engine/sfx_palette.py --demo flagship-output/flagship_sfx.wav",
    "scenes": "node engine/render_scenes.js",
    "render": "python engine/compositor.py",
    "verify": "python engine/verify.py flagship-output/flagship_showcase.mp4 --shots 0,8.2,14.0,18.4,24.5",
    "test": "node test/motion.test.js && node test/storyboard.test.js"
  },
  "keywords": [
    "walkthrough",
    "screen-recording",
    "product-demo",
    "playwright",
    "edge-tts",
    "ffmpeg",
    "motion-design",
    "cursor-physics",
    "cinematic-camera",
    "ai-agent",
    "antigravity-skill"
  ],
  "author": "Narain Karti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/narain-karti/Walkthrough.git"
  },
  "homepage": "https://github.com/narain-karti/Walkthrough#readme",
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
